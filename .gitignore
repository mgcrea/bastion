.DS_Store
.idea/
*.swp

# Xcode
build/
DerivedData/
xcuserdata/
*.xcuserstate
*.moved-aside
*.hmap
*.dSYM
*.dSYM.zip

# Sparkle, fetched and checksum-verified by `make sparkle` rather than committed.
# Pinned by SPARKLE_VERSION + SPARKLE_SHA256 in the Makefile, so a checkout
# reproduces the same framework without carrying 2.6 MB of binary in git.
apps/apple/Vendor/

# The Sparkle update-signing private key, if it is ever exported from the
# keychain. It belongs in the login keychain and one repository secret, never
# on disk beside the code it signs.
sparkle_key.pem

# SwiftPM
.build/
.swiftpm/

# Node
node_modules/
dist/
*.tsbuildinfo

# Secrets — never commit real credentials (see mgcrea-ai/.mcp.json for why)
.env
.env.*
!.env.example
# Worker secrets. `.dev.vars` is what `wrangler dev` reads locally; `.prod.vars`
# is the set `pnpm secrets:prod` pushes. Both hold the licence signing key.
# Globbed rather than listed. `.test.vars` was not covered by the two names that
# were here, and it carries the signing key — one forgotten filename is all it
# takes to commit the one secret that can never be rotated without refusing
# every key ever issued.
*.vars
!*.vars.example
.mcp.json
*.p8
*.p12

# Screenshot pipeline output. Regenerated by `make screenshots` on every run.
#
# Deliberately NOT apps/website/src/assets/shots/ — the site imports those at
# build time through astro:assets, so they are committed (via LFS) exactly like
# the icon PNGs the site derives. Ignoring them would break `astro build` on any
# clone that has not just run a capture, CI included.
apps/apple/Screenshots/source/
apps/apple/Screenshots/appstore/
apps/apple/Screenshots/diff/
