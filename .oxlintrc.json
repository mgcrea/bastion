{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-underscore-dangle": ["warn", { "allow": ["_meta"] }]
  },
  "ignorePatterns": ["dist", "node_modules", ".reference", "**/worker-configuration.d.ts"]
}
