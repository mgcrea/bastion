---
import { APP_VERSION, COUNTS, GATEWAY, PRICE, REQUIRES, SHIPPED, TRIAL } from "../config";
import AppleGlyph from "./AppleGlyph.astro";
import Button from "./Button.astro";
import Logo from "./Logo.astro";

/**
 * The four hosts that open the same repository on this machine — the same four
 * `Problem.astro` fans in, and the same four `make smoke` runs concurrently.
 *
 * They are drawn as tabs over ONE config panel because that is the headline's
 * second half: the file is byte-identical in all four, so the four have to be
 * shown holding the same one. An earlier draft argued the first half instead —
 * four identical `mcp-shopify` rows in an Activity Monitor — and four repeated
 * mono strings read as unfilled placeholder data rather than as an argument.
 * `Problem.astro` makes that half of the case properly, with lanes.
 */
const CLIENTS = ["Claude Code", "Cursor", "VS Code", "Terminal"] as const;

/**
 * The entry, before and after — the same `shopify` block those four tabs hold,
 * as it stands in an editor today and as one-click wiring leaves it.
 *
 * It used to show only the second half, over the caption "no secret in it",
 * which asks a first-time reader to take on faith that there WAS one. The
 * credentials are the whole reason this app exists and the page's first
 * argument (`Problem.astro`) is about them, so the hero shows the thing being
 * removed rather than describing the absence of it.
 *
 * A diff and not two panels: the two states are one file, at two moments, and
 * a client wiring is literally this rewrite — every other entry in the file
 * left byte-for-byte alone. Two panels side by side would say "here are two
 * ways to configure a server", which is a choice nobody has to make.
 *
 * The `-` lines are `mcp-shopify`'s real invocation and its real variable
 * names, from `servers.json` — the store domain, the client id and the client
 * secret, which is the set a Shopify custom app actually needs. Inventing a
 * plausible-looking `SHOPIFY_API_KEY` here would be a fake credential shape in
 * the one place on the page a reader checks against their own file. The VALUES
 * are fabricated and truncated, and have to stay that way: `shpss_` is the
 * right prefix, and nothing after it is.
 *
 * `tone` marks the one line the eye is meant to land on. The rest of the
 * removed block is dimmed — a diff where six lines shout is a diff nobody
 * reads.
 */
interface ConfigLine {
  /** `-` removed, `+` added, undefined for the untouched frame. */
  mark?: "-" | "+";
  /** Indent depth, three spaces to the level, as the file is pretty-printed. */
  d: number;
  text: string;
  /** The quoted value, split out only when it is coloured apart from its key. */
  val?: string;
  tone?: string;
}

const CONFIG: ConfigLine[] = [
  { d: 0, text: "{" },
  { d: 1, text: '"mcpServers": {' },
  { d: 2, text: '"shopify": {' },
  { mark: "-", d: 3, text: '"command": ', val: '"npx",' },
  { mark: "-", d: 3, text: '"args": ', val: '["-y", "@mgcrea/mcp-shopify"],' },
  { mark: "-", d: 3, text: '"env": {' },
  { mark: "-", d: 4, text: '"SHOPIFY_STORE_DOMAIN": ', val: '"acme.myshopify.com",' },
  { mark: "-", d: 4, text: '"SHOPIFY_CLIENT_ID": ', val: '"8f2c1d94…",' },
  {
    mark: "-",
    d: 4,
    text: '"SHOPIFY_CLIENT_SECRET": ',
    val: '"shpss_4b7e0a…"',
    tone: "text-danger-ink",
  },
  { mark: "-", d: 3, text: "}" },
  {
    mark: "+",
    d: 3,
    text: '"url": ',
    val: `"${GATEWAY.origin}/s/prod/shopify"`,
    tone: "text-accent-hi",
  },
  { d: 2, text: "}" },
  { d: 1, text: "}" },
  { d: 0, text: "}" },
];

/**
 * The menu, as the app draws it. Five profiles across four states — running,
 * idle-stopped, writes off, writes on — because the states are the feature: a
 * profile is the unit that carries a credential set AND a write permission, and
 * a menu showing five green rows would say neither.
 */
interface MenuRow {
  name: string;
  state: string;
  /** The state text's colour — the row's whole signal, so it is per-row data. */
  tone: string;
  /** The row the pointer is over, drawn as the app draws a hover. */
  active: boolean;
  /** A stopped profile: the NAME dims too, not just its state. */
  dim?: boolean;
}

/**
 * The same five profiles `DemoSeed.profiles` seeds, in the same states.
 *
 * That mirror is not decoration: the screenshots in `Screens.astro` further
 * down the page are photographs of an app holding exactly this list, and a
 * drawing that disagrees with the picture beside it is worse than no drawing.
 * `staging/shopify` is the one short a credential here because it is the one
 * short a credential there — which is also why `running` in that set shows four
 * supervised instances for five profiles rather than five.
 *
 * Nothing enforces this. Change the two together.
 */
const MENU: MenuRow[] = [
  { name: "prod/shopify", state: "running", tone: "text-ok-ink", active: true },
  { name: "acme/keycloak", state: "running", tone: "text-ok-ink", active: false },
  { name: "staging/shopify", state: "needs a credential", tone: "text-warn", active: false, dim: true },
  { name: "home/unifi-network", state: "idle · stopped", tone: "text-fg/35", active: false, dim: true },
  { name: "lab/unifi-network", state: "writes on", tone: "text-warn", active: false },
];

/** The two calls the Activity window has recorded, with what they were called with. */
const CALLS = [
  { call: "tools/call · shopify_get_order", meta: "read · 84 ms", lit: true },
  { call: "tools/call · shopify_list_products", meta: "read · 39 ms", lit: false },
] as const;
---

<section id="top" class="relative overflow-hidden px-0 pt-[88px]">
  {/* cupertino's alpha, and static. The geometry was already identical; the
      difference was .28 against .26 and a 10s breathe this no longer has. */}
  <div
    class="pointer-events-none absolute inset-x-0 -top-[200px] h-[680px]"
    style="background:radial-gradient(58% 68% at 50% 0%,rgb(242 137 92 / 26%) 0%,rgb(242 137 92 / 5%) 46%,transparent 72%)"
    aria-hidden="true"
  >
  </div>

  <div class="wrap relative flex flex-wrap items-center gap-16">
    <div class="flex min-w-[min(400px,100%)] flex-1 basis-[568px] flex-col gap-6">
      <div
        class="flex items-center gap-2 self-start rounded-full border border-rule-2 px-3.5 py-1.5 text-[11.5px] font-medium text-fg-dim"
      >
        {/* The dot was `bg-warn` under an "Early" label, which is the right
            pairing for a pre-release and the wrong one for a shipped build: an
            amber dot next to a Download button reads as a warning about the
            download. It also pulsed on a 2.4s loop, which read as a live status
            indicator for something that is not live. */}
        <span
          class:list={["size-1.5 rounded-full", SHIPPED ? "bg-ok-ink" : "bg-warn"]}
          aria-hidden="true"></span>
        {
          SHIPPED
            ? `${APP_VERSION} · signed, notarized, and sold direct`
            : "Early · the gateway serves a real server end to end"
        }
      </div>

      {/* Two-tone, which is cupertino's treatment and replaces the white-into-grey
          `headline-ramp` this used to wear. The accent lands on the payoff rather
          than on the subject: "one server" is the mechanism, "for every client"
          is the claim the rest of the page spends its length defending. */}
      <h1
        class="m-0 font-display text-[clamp(38px,5.6vw,64px)] leading-[1.02] font-semibold tracking-[-0.045em] text-balance"
      >
        One MCP server, running once,<br /><span class="text-accent">for every client.</span>
      </h1>

      <p class="m-0 max-w-[50ch] text-[16.5px] leading-[1.62] text-fg-dim text-pretty">
        Bastion is a menu-bar app that supervises your MCP servers instead of letting each editor
        spawn its own. One process per profile, credentials in the Keychain, and every tool call
        recorded.
      </p>

      {/* The plate button is the one thing to do next, and what that is changed
          at 1.0.0. It used to be "How it works", because there was nothing to
          download and the argument was the whole offer; now the argument is
          still one click away, but it is not the primary action any more. */}
      <div class="flex flex-wrap items-center gap-3.5 pt-1">
        {
          SHIPPED ? (
            <>
              <Button href="/download" size="lg">
                <AppleGlyph size={16} />
                Download for macOS
              </Button>
              <Button href="#how" variant="secondary" size="lg">
                How it works →
              </Button>
            </>
          ) : (
            <>
              <Button href="#how" size="lg">
                How it works →
              </Button>
              <Button href="#rules" variant="secondary" size="lg">
                The five rules
              </Button>
            </>
          )
        }
      </div>

      <span class="text-[12.5px] text-fg-muted">
        {REQUIRES} · loopback only ·{" "}
        {SHIPPED ? `${TRIAL.minutes}-minute trial, then ${PRICE.price}` : "not shipped yet"}
      </span>
    </div>

    <div class="reveal flex min-w-[min(400px,100%)] flex-1 basis-[480px] flex-col gap-3">
      <div
        class="overflow-hidden rounded-[11px] border border-white/11 bg-bg-3 shadow-[0_24px_60px_-34px_rgb(0_0_0/90%)]"
      >
        {/* Four tabs, one file. The first is lit only so the stack reads as tabs
            rather than as a row of chips; nothing behind them differs. */}
        <div class="flex gap-1 border-b border-white/8 bg-white/5 px-1.5 pt-1.5">
          {
            CLIENTS.map((name, i) => (
              <span
                class:list={[
                  "truncate rounded-t-[7px] px-2.5 py-2 text-[11.5px]",
                  i === 0 ? "bg-bg-3 font-semibold text-fg" : "text-fg/45",
                ]}
              >
                {name}
              </span>
            ))
          }
        </div>
        {/* Indented with an inline `padding-left` rather than a `pl-*` class per
            depth: the gutter column has to stay at x=0 for the marks to line up,
            so the indent belongs to the text span, and five depths of Tailwind
            class would be five strings saying `d * 11`. */}
        <div class="flex flex-col py-3 font-mono text-[11.5px] leading-[1.75]">
          {
            CONFIG.map((l) => (
              <div
                class:list={[
                  "flex gap-2 px-3.5",
                  l.mark === "-" && "bg-danger/8",
                  l.mark === "+" && "bg-ok/10",
                ]}
              >
                <span
                  class:list={[
                    "w-2 shrink-0 select-none",
                    l.mark === "-"
                      ? "text-danger-ink/75"
                      : l.mark === "+"
                        ? "text-ok-ink/75"
                        : "text-transparent",
                  ]}
                  aria-hidden="true"
                >
                  {l.mark ?? "·"}
                </span>
                <span class="min-w-0 break-all" style={`padding-left:${l.d * 11}px`}>
                  <span class={l.mark === "-" ? "text-fg/38" : "text-fg/70"}>{l.text}</span>
                  {l.val && (
                    <span class={l.tone ?? (l.mark === "-" ? "text-fg/38" : "text-fg/55")}>
                      {l.val}
                    </span>
                  )}
                </span>
              </div>
            ))
          }
        </div>
      </div>
      <span class="sr-only">
        The shopify entry in a client's mcp.json, before and after wiring: a command, its arguments
        and three environment variables — a store domain, a client id and a Shopify client secret in
        plaintext — all removed, and one url pointing at the Bastion gateway added in their place.
      </span>
      <span class="font-mono text-[11px] text-fg-muted">
        The same file in all {CLIENTS.length} · the credential moves out of it
      </span>

      <span class="self-center text-[15px] text-fg/30" aria-hidden="true">↓</span>

      <div
        class="flex items-center gap-2.5 rounded-[11px] border border-accent/28 bg-bg-3 px-3.5 py-3 shadow-[0_24px_60px_-34px_rgb(0_0_0/90%)]"
      >
        <Logo size={18} />
        <span class="flex-1 truncate font-mono text-[11.5px]">
          prod/shopify <span class="text-fg-muted">· one process, all {CLIENTS.length}</span>
        </span>
        <span class="shrink-0 font-mono text-[10.5px] text-ok-ink">running</span>
      </div>
      <span class="font-mono text-[11px] text-fg-muted">Keychain · every call recorded</span>
    </div>
  </div>

  {/* ── The menu bar mock ──────────────────────────────────────────────────────
      A slab of macOS with the popover open, bleeding off the bottom of the hero
      into the marquee. It is a drawing, not a screenshot — and the reason is no
      longer the one that used to be written here.

      It said there was no signed build to photograph, and that a mock admitting
      to being one beat a screenshot of a Debug build with somebody's real store
      domain in it. Both halves have moved: `make screenshots` photographs a
      Release build from a demo fixture, and `Screens.astro` further down the
      page carries six of those.

      It stays drawn because a capture cannot do this particular job. A menu bar
      popover is a high-layer panel rather than an ordinary window, so appshot
      cannot photograph it at all, and it has to reflow on a phone. The config
      panel above earns the same exemption: four editors each hold their own copy
      of that file, and no one screenshot shows the four agreeing. Those are the
      only reasons anything on this page is drawn, and each drawing should be
      able to name its own.

      What it must NOT do is disagree with the photographs. `MENU` above holds
      the same five profiles in the same states as `DemoSeed.profiles`. */}
  <div
    class="relative mx-auto -mb-px mt-[72px] w-full max-w-[1160px] overflow-hidden rounded-t-2xl border border-b-0 border-rule-2"
    style="background:linear-gradient(180deg,#1B1D21 0%,#101114 100%)"
  >
    <div
      class="flex h-[27px] items-center justify-between border-b border-white/7 bg-white/8 px-3.5"
    >
      <div class="flex items-center gap-4 text-[11.5px] text-fg/75">
        <span class="font-semibold">Claude</span>
        <span class="hidden sm:inline">File</span>
        <span class="hidden sm:inline">Edit</span>
        <span class="hidden sm:inline">View</span>
        <span class="hidden sm:inline">Window</span>
        <span class="hidden sm:inline">Help</span>
      </div>
      <div class="flex items-center gap-3.5">
        <span class="flex rounded-[5px] bg-accent/18 px-[7px] py-0.5">
          {/* The menu bar glyph, served from public/ and written by `pnpm icons`
              out of design/ — an <img> rather than an inline <svg> so the site
              never holds a second copy of the geometry.
              The file is a template image: pure black plus alpha, because AppKit
              paints its own colour through it. Nothing paints it here, and this
              mock's menu bar is dark, so it would render black-on-black. The
              filter is that tint — `brightness(0) invert(1)` forces the ink to
              white whatever colour the source carries.
              The *active* glyph, the fort with its curtain wall: this mock has a
              client mid-session, which is exactly the state the app draws that
              one in. The idle glyph is the bare fort. */}
          <img
            src="/menubar-glyph-active.svg"
            alt=""
            width="15"
            height="15"
            class="opacity-95 [filter:brightness(0)_invert(1)]"
          />
        </span>
        <span class="text-[11.5px] text-fg/65">Thu 09:41</span>
      </div>
    </div>

    {/* Two arrangements, not one that shrinks. The popover is a fixed 286pt
        panel in the real app, so on a phone the code panel cannot share a row
        with it — `calc(100% - 340px)` left it 46px wide and unreadable. Below
        `lg` they stack; from `lg` the code panel goes back to overlapping the
        desktop it is sitting on. */}
    <div
      class="relative flex flex-col items-end gap-5 px-3.5 pt-2.5 lg:min-h-[412px] lg:flex-row lg:justify-end lg:gap-0"
    >
      <div
        class="w-full max-w-[286px] overflow-hidden rounded-[11px] border border-white/12 bg-chrome/97 shadow-[0_24px_60px_-34px_rgb(0_0_0/90%)] lg:self-start"
      >
        <div class="flex items-center gap-2.5 border-b border-white/8 px-4 py-3.5">
          <Logo size={23} />
          <div class="flex flex-col gap-[3px]">
            <span class="text-[12.5px] font-semibold">Bastion</span>
            <span class="text-[10.5px] text-fg/50">2 profiles running</span>
          </div>
        </div>
        <div class="flex flex-col gap-px px-1.5 pb-2.5 pt-1.5">
          {
            MENU.map((m) => (
              <div
                class:list={[
                  "flex items-center justify-between rounded-[7px] px-2.5 py-2",
                  m.active && "bg-white/6",
                ]}
              >
                <span class:list={["font-mono text-[12px]", m.dim ? "text-fg/50" : "text-fg"]}>
                  {m.name}
                </span>
                <span class:list={["font-mono text-[10.5px]", m.tone]}>{m.state}</span>
              </div>
            ))
          }
          <div class="mx-2.5 my-1.5 h-px bg-white/9"></div>
          <div class="flex items-center justify-between px-2.5 py-2">
            <span class="text-[12px]">Gateway</span>
            <span class="font-mono text-[10.5px] text-ok-ink">{GATEWAY.host}:{GATEWAY.port}</span>
          </div>
          <div class="flex items-center justify-between px-2.5 py-2">
            <span class="text-[12px]">Writes</span>
            <span class="font-mono text-[10.5px] text-fg/50">per profile</span>
          </div>
          <div class="mx-2.5 my-1.5 h-px bg-white/9"></div>
          <div class="px-2.5 py-2 text-[12px] text-fg/72">Copy .mcp.json snippet</div>
          <div class="px-2.5 py-2 text-[12px] text-fg/72">Open Activity…</div>
          <div class="px-2.5 py-2 text-[12px] text-fg/72">Quit Bastion</div>
        </div>
      </div>

      <div
        class="box-border flex w-full flex-col gap-3.5 rounded-t-xl border border-b-0 border-white/9 bg-[rgb(19_20_23/94%)] px-5.5 py-5 lg:absolute lg:bottom-0 lg:left-6 lg:w-[560px] lg:max-w-[calc(100%-340px)]"
      >
        {/* The URL is not repeated here: the config panel in the right column
            already carries it, and one line printed twice in one hero reads as
            two lines. What this panel adds is what the gateway then records. */}
        <span class="font-mono text-[11px] text-fg-muted">Activity · prod/shopify</span>
        <div class="flex flex-col gap-[7px]">
          {
            CALLS.map((c) => (
              <div
                class:list={[
                  "flex items-center gap-2.5 rounded-[9px] border px-2.5 py-2.5",
                  c.lit ? "border-accent/20 bg-accent/9" : "border-white/8 bg-white/4",
                ]}
              >
                <code class:list={["font-mono text-[11.5px]", c.lit ? "text-accent-hi" : "text-fg/70"]}>
                  {c.call}
                </code>
                <span class="ml-auto font-mono text-[10.5px] text-fg-muted">{c.meta}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
  <span class="sr-only">
    A drawing of the menu bar popover listing {COUNTS.servers} servers' worth of profiles, and the
    calls the gateway has recorded.
  </span>
</section>
