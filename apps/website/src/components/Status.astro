---
import SectionHeader from "./SectionHeader.astro";
import { DIALECT, clientList } from "../config";

/**
 * The build order, as it actually stands. The root README's Status table is the
 * authority; if the two disagree the README is right and this is stale.
 *
 * `tag` is deliberately narrow — built / green / next / not started — because a
 * status page whose vocabulary grows is one that has started describing feelings
 * rather than state. Everything reads `built` or `green` today; the other two
 * stay because the next thing to be in progress will want them, and inventing a
 * vocabulary under deadline is how "mostly done" gets onto a page.
 */
const STATUS = [
  {
    k: "Gateway",
    v: "Loopback HTTP with Origin, Host and bearer checks, hand-written so they stay auditable.",
    tag: "built",
    tone: "text-ok-ink",
  },
  {
    k: "Supervisor",
    v: "One child per profile, id remapping, backoff, circuit breaker, idle stop.",
    tag: "built",
    tone: "text-ok-ink",
  },
  {
    k: "Dialect",
    v: `Dual-era: modern ${DIALECT.modern} and legacy initialize, onto legacy children. ${DIALECT.conformanceChecks} conformance checks.`,
    tag: "built",
    tone: "text-ok-ink",
  },
  {
    k: "OAuth 2.1",
    v: "Discovery from the 401, dynamic registration, PKCE S256 and refresh. One consent per profile; every client shares the token and none of them sees it.",
    tag: "built",
    tone: "text-ok-ink",
  },
  {
    k: "Remote servers",
    v: "An https endpoint fronted like any other server — Stripe's is in the catalog. No process to share, so what it keeps is the Keychain, the identity and the audit line.",
    tag: "built",
    tone: "text-ok-ink",
  },
  {
    k: "Keychain",
    v: "Per-profile credentials, per-client tokens. profiles.json holds no secret value.",
    tag: "built",
    tone: "text-ok-ink",
  },
  {
    k: "Activity window",
    v: "What is running, who is attached, and every tool call, live.",
    tag: "built",
    tone: "text-ok-ink",
  },
  {
    k: "Migration",
    v: "Four .mcp.json credential sets moved into the Keychain, and their configs repointed here.",
    tag: "built",
    tone: "text-ok-ink",
  },
  {
    k: "make smoke",
    v: "Four concurrent clients, colliding ids, exactly one child, kill -9 recovery.",
    tag: "green",
    tone: "text-ok-ink",
  },
  {
    k: "Client wiring",
    v: `One click for ${clientList}: a token minted, written into their config, and every other entry in the file left byte-for-byte alone.`,
    tag: "built",
    tone: "text-ok-ink",
  },
  {
    k: "bastion-bridge",
    v: "Stdio-only hosts like Claude Desktop reach the gateway over HTTP, and it starts Bastion if it is not up.",
    tag: "built",
    tone: "text-ok-ink",
  },
  {
    k: "Bastion's server",
    v: "Bastion as one of its own servers, so an agent can manage it. Off by default, and no tool of it returns a secret.",
    tag: "built",
    tone: "text-ok-ink",
  },
  {
    k: "Release",
    v: "Signed, notarized, and shipped from GitHub releases with a Sparkle appcast. Licences are Ed25519, verified offline, no activation call.",
    tag: "built",
    tone: "text-ok-ink",
  },
] as const;

/**
 * The gaps, said out loud. The first is the one that bites today — it is a
 * consequence of the migration having already happened, not a future risk.
 */
const LIMITS = [
  "The repointed repos need Bastion running: four .mcp.json files now call the gateway instead of spawning anything, and there is no login item yet.",
  "Sampling, elicitation and roots are refused with an explanatory error, not routed — a shared instance has no single client to ask.",
  "A remote server's write gate is a filter, not a boundary: Bastion refuses to forward the named tools, but anyone holding the credential can call the same API directly. Its own scopes are the real limit.",
  "A remote server's rate limit is shared. Behind one profile every client spends one budget upstream, so a client in a loop can exhaust it for the rest.",
  "Responses are a single JSON object, never an SSE stream: no notifications/progress on a long call.",
  "Mcp-Param-* headers are forwarded but not validated; no server in the manifest annotates a parameter yet.",
] as const;
---

<section id="status" class="border-t border-rule py-20">
  <div class="wrap flex flex-wrap items-start gap-16">
    <SectionHeader heading="Status">
      {/* This said "there is no client wiring, no bridge, and no notarized
          build" until all three shipped in 1.0.0. The list below is the useful
          half of a status section once everything is built — what it still does
          not do. */}
      <p class="m-0 text-[15px] leading-[1.6] text-fg/55 text-pretty">
        Everything in the build order landed at 1.0.0: the gateway serves real servers end to end,
        the credentials that used to sit in plaintext are in the Keychain, and the signed build is
        notarized and for sale. What is worth reading is the other column.
      </p>
      <div class="flex flex-col gap-2.5 pt-1.5">
        <h3 class="eyebrow m-0 text-fg/40">Known gaps</h3>
        <ul class="m-0 flex list-none flex-col gap-2.5 p-0">
          {
            LIMITS.map((l) => (
              <li class="text-[13px] leading-[1.55] text-fg/50 text-pretty">{l}</li>
            ))
          }
        </ul>
      </div>
    </SectionHeader>

    <dl class="m-0 flex min-w-[min(380px,100%)] flex-1 basis-[480px] flex-col">
      {
        STATUS.map((s) => (
          <div class="flex flex-wrap items-baseline gap-x-6.5 gap-y-1 border-b border-rule py-4">
            <dt class="basis-[170px] shrink-0 font-mono text-[14px] leading-[1.5] font-medium">
              {s.k}
            </dt>
            <dd class="m-0 flex-1 basis-[240px] text-[14px] leading-[1.55] text-fg/58 text-pretty">
              {s.v}
            </dd>
            <span
              class:list={[
                "shrink-0 font-mono text-[10.5px] leading-[1.9] tracking-[0.05em] uppercase",
                s.tone,
              ]}
            >
              {s.tag}
            </span>
          </div>
        ))
      }
    </dl>
  </div>
</section>
