---
import { DOCS, PRICE, REPO_URL, SHIPPED } from "../config";
import Button from "./Button.astro";
import Logo from "./Logo.astro";

/**
 * Sticky, translucent, and 58px tall to match the canvas. `scroll-padding-top`
 * in global.css is 70px rather than 58 so an anchored section does not land
 * flush under the bar.
 */
const LINKS = [
  { href: "#how", label: "How it works" },
  { href: "#rules", label: "Security" },
  { href: "#servers", label: "Servers" },
  { href: "#screens", label: "The app" },
  { href: "#status", label: "Status" },
  { href: "#pricing", label: "Price" },
] as const;
---

<header
  class="sticky top-0 z-40 h-[58px] border-b border-rule bg-bg/70 backdrop-blur-xl backdrop-saturate-150"
>
  <nav class="wrap flex h-full items-center justify-between">
    <a href="#top" class="flex items-center gap-2.5">
      <Logo size={23} />
      <span class="text-[14.5px] font-semibold tracking-[-0.02em]">Bastion</span>
    </a>

    <div class="flex items-center gap-5 text-[13px] sm:gap-[30px]">
      {
        LINKS.map((link) => (
          <a
            href={link.href}
            class="hidden text-fg-dim transition-colors hover:text-fg sm:inline"
          >
            {link.label}
          </a>
        ))
      }
      <Button href={REPO_URL} variant="quiet" size="sm" external aria-describedby="repo-note">
        Read the source ↗
      </Button>
      {/* The caveat, kept out of the visible label so the button stays one line
          on a phone. It used to say there was no release to download, which
          stopped being true at 1.0.0 — a sentence a screen reader would have
          gone on repeating past the launch, next to a Download button. */}
      <span id="repo-note" class="sr-only">
        Opens the GitHub repository in a new tab. The signed build is a separate
        <a href="/download">download</a>; see <a href={DOCS.readme}>the README</a> for what is in
        each.
      </span>
      {
        SHIPPED && (
          <Button href="/download" variant="secondary" size="sm" class="hidden sm:inline-flex">
            Download
          </Button>
        )
      }
      {/* Buy is the primary action in the nav, and Download is secondary — the
          same hierarchy cupertino uses, for the same reason. The nav is the one
          element on every page and on every scroll position, so whatever sits
          here as the accent button is what the site is asking for. Download was
          taking that slot while the thing being sold had no button at all.

          The price is in the label rather than behind the click. Somebody who
          learns the number only after reaching Stripe has been made to work for
          it, and they read that as a tactic. */}
      {
        SHIPPED && (
          <Button href="/buy" size="sm">
            Buy · {PRICE.amount}
          </Button>
        )
      }
    </div>
  </nav>
</header>
