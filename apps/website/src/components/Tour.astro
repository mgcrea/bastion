---
/**
 * The app, moving, at the head of `Screens`.
 *
 * It sits there and not under the hero: a full-width loop as the first thing
 * after the H1 read as a promo reel, and it showed the panes before the page had
 * said why any of them matter. Here the runtime, the context cost and the record
 * have all been argued, and the captures that follow are the same window,
 * stopped. `make site-video` renders it from the `tour` entry in
 * apps/apple/Screenshots/screenshots.config.json, out of the same captures
 * `ServerPane.astro` and `Screens.astro` show still, and writes it to
 * public/video — so it goes stale exactly when they do, and a fresh
 * `make screenshots` wants a `make site-video` after it. From public/ and not
 * astro:assets, which does nothing for video.
 *
 * Its captions are burned in and are the hero's own three claims (one process
 * per profile, credentials in the Keychain, every call recorded) plus the
 * wiring one. Reword one of those on the page and this still says the old
 * words until somebody re-renders.
 *
 * `preload="none"` and no `autoplay`: the script below plays it only while it
 * is on screen, and not at all under reduced motion, where it stays on its
 * poster with the controls showing. The controls are the no-JS fallback too.
 * Muted because it has no sound to lose.
 *
 * Full 1160 CSS px column, plate styling and caption row of the captures below
 * it, so the window in it reads at the scale they do. A figure, not a section:
 * `Screens` places it in its column and owns the spacing.
 */
---

<figure id="tour" class="reveal m-0 scroll-mt-24">
  <video
    data-tour
    src="/video/tour.mp4"
    poster="/video/tour.jpg"
    width="1920"
    height="1080"
    muted
    loop
    playsinline
    controls
    preload="none"
    aria-label="A twenty-second loop of Bastion's window: the Running pane with one process per profile and the clients attached to it, the Shopify server's environment with its client secret marked secret, the log with a client_secret argument redacted, and Claude Code's config entries pointing at the gateway."
    class="block h-auto w-full rounded-[14px] border border-rule-2 shadow-[0_24px_60px_-34px_rgb(0_0_0/90%)]"
  >
  </video>
  <figcaption class="mt-5 flex flex-wrap items-start gap-x-16 gap-y-2">
    <h3 class="m-0 flex-1 basis-[456px] font-display text-[20px] font-semibold tracking-[-0.03em] text-fg">
      Twenty seconds of it, moving.
    </h3>
    <p class="m-0 flex-1 basis-[456px] text-[14.5px] leading-[1.65] text-fg-dim text-pretty">
      One process per profile, the credentials it holds back, the log as calls land, and the
      entries it writes into an editor's config. The captures below are the same window, stopped.
    </p>
  </figcaption>
</figure>

<script>
  // Plays the tour only while it is on screen. Reduced motion, or no
  // IntersectionObserver, leaves it as it rendered: paused, with controls.
  const tour = document.querySelector<HTMLVideoElement>("video[data-tour]");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (tour && !still && "IntersectionObserver" in window) {
    tour.controls = false;
    new IntersectionObserver(
      ([entry]) => {
        if (entry?.isIntersecting) void tour.play().catch(() => (tour.controls = true));
        else tour.pause();
      },
      { threshold: 0.4 },
    ).observe(tour);
  }
</script>
