---
import { DOCS, PRICE, REPO_URL, REQUIRES, SIBLING_APP } from "../config";
import Logo from "./Logo.astro";
import MagentaMark from "./MagentaMark.astro";

const COLUMNS = [
  {
    heading: "Read",
    items: [
      { label: "How it works", href: "#how" },
      { label: "Security", href: "#rules" },
      { label: "The app", href: "#screens" },
      { label: "Servers", href: "#servers" },
      { label: "Status", href: "#status" },
    ],
  },
  {
    heading: "Get it",
    items: [
      { label: "Download", href: "/download" },
      { label: `Buy — ${PRICE.price}`, href: "/buy" },
      { label: "Release notes", href: "/releases" },
      { label: "Checksum", href: "/checksum" },
    ],
  },
  {
    heading: "Build",
    items: [
      { label: "make app", href: null },
      { label: "make audit", href: null },
      { label: "make smoke", href: null },
      { label: "make dialect", href: null },
    ],
  },
  /**
   * The sibling. It is a column of one rather than a line tacked onto "Read",
   * because the three headings above it all name parts of Bastion and this does
   * not — and because the footer renders on every page here, which is the whole
   * reason the cross-link lives down here as well as on the homepage.
   */
  {
    heading: "More apps",
    items: [{ label: `${SIBLING_APP.name} ↗`, href: SIBLING_APP.url }],
  },
] as const;

/**
 * Separate from `COLUMNS` because these are the two links a person goes looking
 * for rather than browses to, and burying them under a heading of their own is
 * how a privacy page ends up unfindable.
 */
const LEGAL = [
  { label: "Licence terms", href: "/terms" },
  { label: "Privacy", href: "/privacy" },
  { label: "Licensing, in full", href: DOCS.licensing },
] as const;
---

<footer class="border-t border-rule bg-bg-deep py-12">
  <div class="wrap grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr_1fr]">
    <div class="flex flex-col gap-3">
      <a href={REPO_URL} rel="noopener" class="flex items-center gap-2.5">
        <Logo size={22} />
        <span class="text-[14.5px] font-semibold tracking-[-0.02em] text-fg">Bastion</span>
      </a>
      {/* This said "code-signed for development only" and "licence not settled"
          until 1.0.0, when both stopped being true in the same release. A
          footer is where that kind of line survives longest, because nobody
          reads it on the way past. */}
      <p class="m-0 text-[12.5px] leading-[1.6] text-fg-muted">
        Requires {REQUIRES}. Signed and notarized.<br />
        Source-available · {PRICE.price} for the signed build
      </p>
      <span class="flex flex-wrap gap-x-3 gap-y-1 text-[12px] text-fg-muted">
        {
          LEGAL.map((item) => (
            <a href={item.href} class="text-fg-muted transition-colors hover:text-accent-hi">
              {item.label}
            </a>
          ))
        }
      </span>
      {/* The publisher, in the one form every mgcrea site now uses: the mark, the
          name, and a link out. This footer named no publisher at all until here —
          the repo link at the top is the product's, not the studio's. */}
      <a
        href="https://mg-crea.com"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 text-[12.5px] text-fg-muted transition-colors hover:text-accent-hi"
      >
        <MagentaMark size={13} uid="footer" />Magenta Creations
      </a>
    </div>

    {
      COLUMNS.map((col) => (
        <div class="flex flex-col gap-3">
          <div class="font-mono text-[10.5px] font-medium uppercase tracking-[0.12em] text-fg-muted">
            {col.heading}
          </div>
          <ul class="m-0 flex list-none flex-col gap-2 p-0">
            {col.items.map((item) => (
              <li>
                {item.href ? (
                  <a
                    href={item.href}
                    target={item.href.startsWith("http") ? "_blank" : undefined}
                    rel={item.href.startsWith("http") ? "noopener" : undefined}
                    class="text-[13px] text-fg/50 transition-colors hover:text-accent-hi"
                  >
                    {item.label}
                  </a>
                ) : (
                  <span class="font-mono text-[12px] text-fg/50">{item.label}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</footer>
