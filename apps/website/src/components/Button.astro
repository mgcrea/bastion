---
/**
 * The one place a call to action is styled.
 *
 * There are four of them on this page — nav, hero, pricing plate, closing plate
 * — and they were four hand-written class strings that had already drifted
 * apart in radius, padding and weight. A button that looks slightly different
 * in the nav than in the hero reads as two different offers, which is the
 * opposite of what a page with one thing to sell wants.
 *
 * Every value here is cupertino's, to the pixel. The two sites sell the same
 * way and should ask the same way.
 *
 * `external` is opt-in rather than inferred from the href, because the two
 * off-site links that matter most are opposite cases: GitHub wants a new tab,
 * and `/download` must not have one — it is a 302 to a zip, and a tab that
 * opens only to close itself is worse than no tab.
 *
 * **Responsive hiding does not belong on this component.** `hidden` passed
 * through `class` loses to the `inline-flex` in the base list below: Tailwind
 * emits `.inline-flex` after `.hidden` in the utilities layer and the two have
 * equal specificity, so the button stays visible. Wrap it in a
 * `<span class="hidden sm:block">` instead — see `Nav.astro`.
 */
interface Props {
  href: string;
  /** `primary` is the accent fill; there is at most one per viewport. */
  variant?: "primary" | "secondary" | "quiet";
  size?: "sm" | "md" | "lg";
  external?: boolean;
  class?: string;
  "aria-describedby"?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  external = false,
  class: className,
  ...rest
} = Astro.props;

/**
 * A flat fill, and no shadow of any kind.
 *
 * `primary` was the icon's own gradient with a 34px accent-coloured glow behind
 * it. Both are gone. A glow under a button is the page shouting at one element
 * and it made the accent — which is load-bearing precisely because it is
 * rationed — the loudest thing on every screen it appeared on. The gradient
 * went with it: quoting the icon's ramp is what the app mark is for, and a
 * button wearing it competes with the mark rather than matching it.
 *
 * `quiet` lifts to a full accent fill on hover rather than a paler grey. It is
 * the nav's GitHub button, and the hover is what tells you it is a button at
 * all.
 */
const VARIANTS = {
  primary: "bg-accent font-medium text-accent-ink hover:bg-accent-hi",
  secondary: "border border-rule-2 text-fg hover:border-fg-muted",
  quiet:
    "bg-[color-mix(in_srgb,var(--color-fg)_8%,transparent)] text-fg hover:bg-accent hover:text-accent-ink",
} as const;

/**
 * `md` and `lg` name a literal 10px rather than `rounded-md`, and that is
 * cupertino's choice rather than an oversight: the radius token moved with the
 * cards, and a button that followed it grew a corner nobody asked for.
 */
const SIZES = {
  sm: "rounded-lg px-[13px] py-[7px] text-[13px]",
  md: "rounded-[10px] px-[19px] py-[11px] text-[14px]",
  lg: "rounded-[10px] px-[22px] py-3 text-[14.5px]",
} as const;
---

<a
  href={href}
  {...external ? { target: "_blank", rel: "noopener" } : {}}
  {...rest}
  class:list={[
    "inline-flex items-center justify-center gap-1.5 text-center whitespace-nowrap transition-colors",
    VARIANTS[variant],
    SIZES[size],
    className,
  ]}
>
  <slot />
</a>
