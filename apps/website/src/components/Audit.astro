---
import SectionHeader from "./SectionHeader.astro";

/** What crosses the gateway, and is therefore recorded. */
const SEES = ["profile", "method", "tool name", "arguments", "results", "outcome"] as const;

/**
 * What does not. This list is the honest half of the section. "credentials" is
 * absent by choice and enforced in one place; the other two are absent because
 * Bastion is not in that path at all and no setting can put it there.
 *
 * "results" moved out of this list when a profile could opt into them, and
 * "arguments" when they became the default. Anything added to SEES has to come
 * out of here in the same commit, or the page is claiming a blindness it no
 * longer has.
 */
const BLIND = ["credentials", "egress", "file reads"] as const;
---

<section class="wrap py-[96px]">
  <div class="flex flex-wrap items-start gap-16">
    <SectionHeader eyebrow="The record" heading="A record of requests, not a sandbox.">
      <p class="m-0 text-[16px] leading-[1.6] text-fg-dim text-pretty">
        Bastion sees the JSON-RPC frames crossing the gateway, down to what each tool was called
        with. Credentials are never recorded, and nothing is written to disk unless you ask for an
        audit log — which is chained, so an edited or missing record shows. It does not see what a
        server then does over the network or on the filesystem — and the page says so rather than
        implying otherwise.
      </p>
    </SectionHeader>

    <div class="flex min-w-[min(420px,100%)] flex-1 basis-[520px] flex-wrap gap-4">
      <div
        class="flex min-w-[min(230px,100%)] flex-1 basis-[230px] flex-col gap-4.5 rounded-lg border border-ok/22 px-8 py-7.5"
        style="background:linear-gradient(180deg,rgb(62 158 99/8%),rgb(255 255 255/3%))"
      >
        <div class="flex items-center gap-2.5">
          <span class="size-[7px] rounded-full bg-ok" aria-hidden="true"></span>
          <h3 class="eyebrow m-0 text-ok-ink">It sees</h3>
        </div>
        <ul class="m-0 flex list-none flex-wrap gap-[7px] p-0">
          {
            SEES.map((s) => (
              <li class="rounded-md border border-ok/26 bg-ok/10 px-2.5 py-2 font-mono text-[12px] text-ok-ink">
                {s}
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="flex min-w-[min(230px,100%)] flex-1 basis-[230px] flex-col gap-4.5 rounded-lg border border-dashed border-white/16 bg-white/2 px-8 py-7.5"
      >
        <div class="flex items-center gap-2.5">
          <span class="size-[7px] rounded-full bg-danger" aria-hidden="true"></span>
          <h3 class="eyebrow m-0 text-danger-ink">It does not</h3>
        </div>
        <ul class="m-0 flex list-none flex-wrap gap-[7px] p-0">
          {
            BLIND.map((s) => (
              <li class="rounded-md border border-white/10 bg-white/3 px-2.5 py-2 font-mono text-[12px] text-fg-muted line-through">
                {s}
              </li>
            ))
          }
        </ul>
        <p class="mt-auto mb-0 text-[13px] leading-[1.6] text-fg-muted text-pretty">
          A server that reads a file it was never asked about does so out of Bastion's sight.
        </p>
      </div>
    </div>
  </div>
</section>
