---
/**
 * One release, at a URL worth sharing.
 *
 * This is the page a post links to, so everything a link preview reads is the
 * release's own: the title, the description, and a card with its version and
 * title on it (`pnpm cards`). Releases from before summaries existed fall back
 * to their first headlines and the site card, and still get a page — an old
 * version's notes are what somebody still on that version wants to read.
 */
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import ShareRelease from "../../components/ShareRelease.astro";
import { APP_NAME } from "../../config";
import { RELEASES, type Release } from "../../data/changelog";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return RELEASES.map((release, index) => ({
    params: { version: release.version },
    props: { release, newer: RELEASES[index - 1], older: RELEASES[index + 1] },
  }));
}

interface Props {
  release: Release;
  newer?: Release;
  older?: Release;
}

const { release, newer, older } = Astro.props;
const { summary } = release;

const headline = summary?.title ?? `${APP_NAME} ${release.version}`;
// Without a summary the headline is already the name and number; repeating it
// after the dash would title the page "Bastion 1.23.0 — Bastion 1.23.0".
const title = summary
  ? `${APP_NAME} ${release.version} — ${headline}`
  : `${APP_NAME} ${release.version} release notes`;
const description =
  summary?.description ??
  (release.highlights.length > 0
    ? `${APP_NAME} ${release.version}: ${release.highlights
        .slice(0, 3)
        // Headlines are written as sentences but not all of them end like one.
        .map((line) => (/[.!?]$/.test(line) ? line : `${line}.`))
        .join(" ")}`
    : `What changed in ${APP_NAME} ${release.version}, released ${release.longDate}.`);
const url = new URL(release.path, Astro.site).href;
// The release's own card when one was rendered, else the site card — and its
// alt only with it, since Layout's default alt describes the site card.
const cardProps = release.card
  ? {
      ogImage: release.card,
      ogImageAlt: `The Bastion icon and wordmark over “Version ${release.version}” and “${headline}”, dated ${release.longDate}.`,
    }
  : {};

const nav = "text-fg-dim transition-colors hover:text-fg";
// The newest release has no "newer" link, and offers the build instead:
// /download is always the newest. Same tab, as everywhere on this site — it is
// a 302 to a zip, and a tab that opens only to close itself is worse than none.
// See Button.astro.
---

<Layout
  title={title}
  description={description}
  {...cardProps}
>
  <Nav />
  <main id="main" tabindex="-1" class="wrap py-20">
    <div class="max-w-[72ch]">
      <a href="/changelog/" class="eyebrow text-accent transition-colors hover:text-accent-hi">Changelog</a>
      <h1 class="mt-3 mb-0 font-display text-[clamp(28px,4.4vw,40px)] leading-[1.1] font-semibold tracking-[-0.04em] text-balance">
        {headline}
      </h1>
      <p class="mt-4 mb-0 font-mono text-[12.5px] text-fg-muted">
        Version {release.version} · <time datetime={release.date}>{release.longDate}</time>
      </p>
      {
        summary && (
          <p class="mt-6 mb-0 text-[17px] leading-[1.6] text-fg-dim text-pretty">{summary.description}</p>
        )
      }

      {summary && <ShareRelease post={summary.post} url={url} />}

      <div
        class="mt-12 text-[15px] leading-[1.65] text-fg-dim
               [&_h3]:mt-12 [&_h3]:mb-4 [&_h3]:font-display [&_h3]:text-[22px] [&_h3]:font-semibold [&_h3]:tracking-[-0.03em] [&_h3]:text-fg
               [&_p]:mt-4 [&_p]:mb-0 [&_li_p:first-child]:mt-0
               [&_ul]:mt-4 [&_ul]:mb-0 [&_ul]:list-disc [&_ul]:space-y-5 [&_ul]:pl-5 [&_ul]:marker:text-fg-muted
               [&_strong]:font-medium [&_strong]:text-fg
               [&_code]:font-mono [&_code]:text-[0.92em] [&_code]:text-fg
               [&_a]:text-fg [&_a]:underline [&_a]:underline-offset-2"
        set:html={release.html}
      />

      <nav class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-rule pt-6 text-[14px]" aria-label="Other releases">
        {older ? <a href={older.path} class={nav}>← {older.version}</a> : <span />}
        <a href="/changelog/" class={nav}>All releases</a>
        {
          newer ? (
            <a href={newer.path} class={nav}>
              {newer.version} →
            </a>
          ) : (
            <a href="/download" class={nav}>
              Download {release.version}
            </a>
          )
        }
      </nav>
    </div>
  </main>
  <Footer />
</Layout>
