---
import Audit from "../components/Audit.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Marquee from "../components/Marquee.astro";
import Nav from "../components/Nav.astro";
import Pricing from "../components/Pricing.astro";
import Problem from "../components/Problem.astro";
import ServerPane from "../components/ServerPane.astro";
import Rules from "../components/Rules.astro";
import Screens from "../components/Screens.astro";
import Servers from "../components/Servers.astro";
import SiblingApp from "../components/SiblingApp.astro";
import Status from "../components/Status.astro";
import {
  APP_NAME,
  APP_VERSION,
  COUNTS,
  PRICE,
  REPO_URL,
  REQUIRES,
  SHIPPED,
  SITE_URL,
} from "../config";
import Layout from "../layouts/Layout.astro";

/**
 * SoftwareApplication rather than Product: what is described is the app, and
 * the sale of the signed build hangs off it as an `offers`.
 *
 * All four of `softwareVersion`, `downloadUrl`, `license` and `offers` are
 * gated on `SHIPPED`, together, and the reason is the same for each: every one
 * of them is a claim about something that exists right now. A price in
 * structured data says the thing can be bought today, and a `downloadUrl`
 * announced early puts a 404 into search results — which is worse than being
 * absent from them. They appear at the release or none of them does.
 *
 * This comment used to say the opposite in each case, and stayed that way
 * through 1.0.0: nothing is for sale, nothing is downloadable, the licence is
 * unsettled. All three stopped being true in one commit, and structured data is
 * the last place anyone looks for stale copy — a search result is the only
 * thing that reads it.
 */
/**
 * Publisher and site identity. `@id` lets the SoftwareApplication schema below
 * point at the same organisation rather than restating it.
 */
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE_URL}/#organization`,
  name: "Magenta Creations",
  url: "https://mg-crea.com",
  email: "support@mgcrea.io",
  sameAs: ["https://mg-crea.com", "https://github.com/mgcrea"],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  name: APP_NAME,
  url: SITE_URL,
  publisher: { "@id": `${SITE_URL}/#organization` },
  inLanguage: "en",
};

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: APP_NAME,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS 26",
  softwareRequirements: REQUIRES,
  url: SITE_URL,
  codeRepository: REPO_URL,
  description: `A macOS menu-bar app that supervises ${COUNTS.serversWord} MCP servers — one process per profile, credentials in the Keychain, and every tool call recorded — instead of letting every editor spawn its own copy.`,
  author: { "@type": "Person", name: "Olivier Louvignes" },
  publisher: { "@id": `${SITE_URL}/#organization` },
  ...(SHIPPED
    ? {
        softwareVersion: APP_VERSION,
        // The vanity path, not the GitHub asset URL. public/_redirects sends it
        // to `latest/download`, so cutting a release never needs a site deploy
        // and never leaves a versioned URL behind in somebody's index.
        downloadUrl: `${SITE_URL}/download`,
        // The APP's licence — the terms the signed build is sold under — not
        // the repository's. Naming a source licence here would describe the
        // wrong artifact for a schema whose `offers` is a paid download.
        license: `${SITE_URL}/terms`,
        offers: {
          "@type": "Offer",
          price: PRICE.amount,
          priceCurrency: PRICE.currency,
          url: `${SITE_URL}/buy`,
          availability: "https://schema.org/InStock",
        },
      }
    : { releaseNotes: `${REPO_URL}#status` }),
};
---

<Layout schema={[organizationSchema, websiteSchema, schema]}>
  <Nav />
  <main>
    <Hero />
    <Marquee />
    {/* The app itself, before the page starts arguing — the same slot cupertino
        gives `SurfacePane`. The hero draws the claim; this photographs it, and
        everything below can then refer back to something already seen. */}
    <ServerPane />
    <Problem />
    <HowItWorks />
    <Audit />
    {/* After the record section and before the light Rules plate: Audit makes
        the claim in prose, this shows the window making it, and Rules then
        breaks the run of dark sections. */}
    <Screens />
    <Rules />
    <Servers />
    <Status />
    {/* Last before the closing plate: the page has finished arguing by here, and
        the price is the only question left. */}
    <Pricing />
    {/* Between the price and the closing plate, never after it. r2-explorer's
        index carries the same note: its page used to end on the sibling card,
        which put an outbound link to a different product below the one CTA this
        page exists to reach. */}
    <SiblingApp />
    <Cta />
  </main>
  <Footer />
</Layout>
