---
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import Logo from "../components/Logo.astro";
import Nav from "../components/Nav.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Not found — Bastion" description="That page does not exist on bastion.mgcrea.io.">
  <Nav />
  <main class="wrap flex min-h-[62vh] flex-col items-center justify-center gap-5 py-24 text-center">
    <Logo size={64} />
    <h1
      class="m-0 font-display text-[clamp(30px,4.4vw,48px)] leading-[1.06] font-semibold tracking-[-0.04em]"
    >
      403 would have been more on brand.
    </h1>
    <p class="m-0 max-w-[46ch] text-[15.5px] leading-[1.68] text-fg-dim text-pretty">
      This one is only a 404 — nothing here refused you, there is simply no such page.
    </p>
    <Button href="/" size="lg">Back to the front</Button>
  </main>
  <Footer />
</Layout>
