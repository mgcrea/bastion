---
import Footer from "../components/Footer.astro";
import Logo from "../components/Logo.astro";
import Nav from "../components/Nav.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Not found — Bastion" description="That page does not exist on bastion.mgcrea.io.">
  <Nav />
  <main class="wrap flex min-h-[62vh] flex-col items-center justify-center gap-5 py-24 text-center">
    <Logo size={64} class="float" />
    <h1 class="m-0 font-display text-[clamp(30px,5vw,44px)] font-semibold tracking-[-0.04em]">
      403 would have been more on brand.
    </h1>
    <p class="m-0 max-w-[46ch] text-[16px] leading-[1.6] text-fg/56 text-pretty">
      This one is only a 404 — nothing here refused you, there is simply no such page.
    </p>
    <a
      href="/"
      class="plate rounded-md px-6 py-3.5 text-[15px] font-semibold text-accent-ink shadow-[0_14px_34px_-14px_rgb(242_137_92/75%)]"
    >
      Back to the front ↗
    </a>
  </main>
  <Footer />
</Layout>
