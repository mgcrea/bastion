{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "0121e8859874c6fc0d674676e17d9f18",
  "name": "bastion-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-03-31",
  "routes": [{ "pattern": "api.bastion.mgcrea.io", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bastion-licenses",
      // From `wrangler d1 create bastion-licenses`. Only the remote binding
      // needs it; `--local` keys on the name, so miniflare ignores this value.
      "database_id": "25d661c7-4963-4cc3-ac0f-8647ae120706",
      "migrations_dir": "./migrations"
    }
  ],
  // Cloudflare Email Service. Sending to arbitrary recipients needs the Workers
  // Paid plan and a verified sender domain, or send() fails E_SENDER_NOT_VERIFIED.
  // mgcrea.io is already verified in this account for cupertino-api.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "CURRENT_MAJOR": "1",
    "LICENSE_FROM_EMAIL": "licences@mgcrea.io",
    "SITE_URL": "https://bastion.mgcrea.io"
  },
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false
}
